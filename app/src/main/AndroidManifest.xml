<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- quickjs-kt 的 AAR 声明 minSdk 23，芝版要保留 minSdk 21；JS 语音只在 API 23+ 使用 -->
    <uses-sdk tools:overrideLibrary="com.dokar.quickjs" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 内置 JS 语音识别：录音 + 访问识别服务 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 跨设备剪贴板同步：前台服务常驻轮询 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- 同步新截屏：监听并读取系统截屏图片 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!--
      引擎数据目录直接放到用户可见的外部存储时，原生层（librime）需要真实文件路径，
      SAF 的 content:// URI 它读不了，只能申请「所有文件访问」。
      未获授权时仍回落到应用私有目录，不影响安装。
    -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name="com.osfans.trime.TrimeApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_app_icon"
        android:label="@string/trime_app_name"
        android:roundIcon="@mipmap/ic_app_icon_round"
        android:theme="@style/Theme.TrimeAppTheme"
        android:hasFragileUserData="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="29">

        <service
            android:name=".data.clipsync.ClipSyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".ime.core.TrimeInputMethodService"
            android:directBootAware="true"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name=".provider.RimeDataProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:directBootAware="true"
            android:exported="false"
            tools:node="merge">
            <!-- remove WorkManager default initializer -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Settings activity -->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.setup.SetupActivity"
            android:exported="false" />

        <activity
            android:name=".ui.voice.VoiceSettingsActivity"
            android:exported="false"
            android:label="@string/voice_input"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.InputStatsActivity"
            android:exported="false"
            android:label="@string/input_stats"
            android:parentActivityName=".ui.main.MainActivity"
            android:theme="@style/Theme.Trime.Stats" />

        <activity
            android:name=".ime.voice.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.Trime.Transparent" />

        <activity
            android:name=".ui.main.LogActivity"
            android:directBootAware="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.settings.theme.ThemeDiagnosticsActivity"
            android:exported="false"
            android:parentActivityName=".ui.main.MainActivity" />

        <activity
            android:name=".ui.main.ClipEditActivity"
            android:autoRemoveFromRecents="true"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:label="@string/edit"
            android:launchMode="singleInstance"
            android:taskAffinity=".ui.main.LiquidKeyboardEditActivity"
            android:theme="@style/Theme.DialogTheme"
            android:windowSoftInputMode="stateAlwaysVisible|adjustPan" />

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="com.osfans.trime.MainLauncherAlias"
            android:exported="true"
            android:label="@string/trime_app_name"
            android:targetActivity=".ui.main.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- All activities must be declared above <activity-alias> tag -->
    </application>
</manifest>
