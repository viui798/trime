<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/setup_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    tools:context=".ui.setup.SetupFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:id="@+id/app_icon_frame"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:background="@drawable/bg_setup_icon"
            app:layout_constraintBottom_toTopOf="@id/step_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:contentDescription="@null" />
        </FrameLayout>

        <TextView
            android:id="@+id/step_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:textColor="@color/settings_on_surface"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/hint_text"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_icon_frame"
            tools:text="启用输入法" />

        <TextView
            android:id="@+id/hint_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/settings_on_surface_variant"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/storage_mode_options"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/step_text"
            tools:text="Hint text here ..." />

        <RadioGroup
            android:id="@+id/storage_mode_options"
            android:background="@drawable/bg_settings_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toTopOf="@id/action_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hint_text">

            <RadioButton
                android:id="@+id/sync_from_external_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/sync_from_external" />

            <TextView
                android:id="@+id/sync_from_external_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/sync_from_external_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp" />

            <RadioButton
                android:id="@+id/app_specific_storage_option"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/use_app_specific_storage" />

            <TextView
                android:id="@+id/app_specific_storage_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/use_app_specific_storage_desc"
                android:textColor="@color/settings_on_surface_variant"
                android:textSize="14sp" />
        </RadioGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action_button"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            app:cornerRadius="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_mode_options"
            tools:text="启用输入法" />

        <ImageView
            android:id="@+id/done_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="28dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_baseline_check_circle_24"
            android:tint="@color/colorPrimary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/done_text"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_mode_options"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/done_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/done"
            android:textColor="@color/colorPrimary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/done_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/done_icon"
            app:layout_constraintTop_toTopOf="@id/done_icon" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
