<com.google.android.material.appbar.AppBarLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/settings_surface"
    android:elevation="0dp"
    app:elevation="0dp">
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/settings_surface"
        android:minHeight="56dp"
        app:contentInsetStartWithNavigation="0dp"
        app:navigationIconTint="@color/settings_on_surface"
        app:titleTextAppearance="@style/TextAppearance.Trime.ToolbarTitle"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:subtitleTextColor="@color/settings_on_surface_variant"
        app:titleTextColor="@color/settings_on_surface" />
</com.google.android.material.appbar.AppBarLayout>
